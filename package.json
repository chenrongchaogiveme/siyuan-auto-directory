{
  "name": "siyuan-auto-directory",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Show a live child-document and referenced-document tree above the current SiYuan document, with per-level pinning and document tags.",
  "license": "MIT",
  "author": "chen",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenrongchaogiveme/siyuan-auto-directory.git"
  },
  "homepage": "https://github.com/chenrongchaogiveme/siyuan-auto-directory",
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "directory",
    "outline",
    "toc"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --import ./tests/register-siyuan-stub.mjs --test tests/*.test.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
